<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvDateHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:text="Today"
        android:textColor="#6B7280"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_group_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvActivityGroupBadge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_badge"
            android:gravity="center"
            android:text="GR"
            android:textColor="#1E4D45"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActivityGroupName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shared Group"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActivityDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="You Paid For Dinner"
                android:textColor="#6B7280"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvActivityAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100 EGP"
            android:textColor="#285951"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
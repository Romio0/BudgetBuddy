<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvExpenseDateHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#374151"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_group_row"
        android:padding="14dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvCategoryIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="🏠"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvExpenseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#111827" />

            <TextView
                android:id="@+id/tvExpensePaidBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paid By Nadia"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvExpenseAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1000EGP"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#111827" />
    </LinearLayout>
</LinearLayout>
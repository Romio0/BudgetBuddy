<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F9FAFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign Up"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Your Account"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Track shared expenses and keep group spending transparent."
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:layout_marginBottom="28dp" />


        <!-- Full Name + Square Camera Button -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <EditText
                android:id="@+id/etSignupName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Enter Your Full Name"
                android:inputType="textPersonName"
                android:paddingHorizontal="16dp"
                android:background="@android:drawable/edit_text"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/ivSignupAvatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@android:drawable/edit_text"
                android:scaleType="centerCrop"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_camera"
                android:contentDescription="Pick Profile Photo" />
        </LinearLayout>

        <!-- Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSignupPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Create Strong Password"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:background="@android:drawable/edit_text"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:layout_marginBottom="18dp" />

        <!-- Phone Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone Number"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="🇪🇬 +20"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:background="@android:drawable/edit_text"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etSignupPhone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="1000 000 000"
                android:inputType="phone"
                android:paddingHorizontal="16dp"
                android:background="@android:drawable/edit_text"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF" />
        </LinearLayout>

        <!-- Sign Up Button -->
        <Button
            android:id="@+id/btnSignup"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Sign Up"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E4D45" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom Switch Link -->
        <TextView
            android:id="@+id/tvGoToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Already have an account? Log In"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E4D45"
            android:gravity="center"
            android:paddingVertical="16dp" />

    </LinearLayout>
</ScrollView>
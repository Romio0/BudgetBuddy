<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_group_row"
    android:padding="14dp">

    <!-- Circular Group Initials Badge -->
    <TextView
        android:id="@+id/tvGroupInitials"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_badge"
        android:gravity="center"
        android:text="LA"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#1E4D45" />

    <!-- Group Name & Balance Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvItemGroupName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LA Trip"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <TextView
            android:id="@+id/tvItemGroupStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You're Owed 500 EGP • BUD-123"
            android:textSize="12sp"
            android:layout_marginTop="3dp"
            android:textColor="#16A34A" />
    </LinearLayout>
    <!-- Right Arrow -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="24sp"
        android:textColor="#9CA3AF" />

</LinearLayout>